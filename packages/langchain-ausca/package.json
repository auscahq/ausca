{
  "name": "langchain-ausca",
  "version": "0.1.1",
  "description": "LangChain tools that pay for HTTP 402 APIs over x402 instead of carrying API keys. Works with any x402 v2 resource; Ausca is the default example.",
  "license": "MIT",
  "homepage": "https://ausca.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auscahq/ausca.git",
    "directory": "packages/langchain-ausca"
  },
  "bugs": "https://github.com/auscahq/ausca/issues",
  "type": "module",
  "keywords": ["langchain", "x402", "payments", "agents", "tools", "ausca"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402/evm": "^2.24.0",
    "@x402/fetch": "^2.24.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "viem": ">=2",
    "zod": ">=3"
  },
  "devDependencies": {
    "@ausca-internal/payable": "*",
    "@langchain/core": "^1.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "viem": "^2.44.0",
    "vitest": "^4.0.0",
    "zod": "^3.25.0"
  },
  "tsup": {
    "noExternal": ["@ausca-internal/payable"]
  }
}
