{
  "name": "ausca-public",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run verify:metadata && npm run test --workspaces --if-present",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "verify:skills": "node scripts/sync-skills.mjs --verify"
  }
}
